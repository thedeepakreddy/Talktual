    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { SUPPORTED_LANGUAGES, Language } from \'../types\';\n\ninterface HomeProps {\n  onStartCall: (lang: Language) => void;\n  onJoinCall: (lang: Language) => void;\n}\n\nexport function Home({ onStartCall, onJoinCall }: HomeProps) {\n  const [selectedLanguage, setSelectedLanguage] = React.useState<Language>(SUPPORTED_LANGUAGES[0]);\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, y: 10 }}\n      animate={{ opacity: 1, y: 0 }}\n      className=\"flex flex-col items-center justify-center min-h-screen p-6 max-w-md mx-auto\"\n    >\n      <div className=\"text-center mb-12\">\n        <h1 className=\"text-4xl font-semibold tracking-tight mb-2\">LinguaLive</h1>\n        <p className=\"text-gray-500\">Live speech translation</p>\n      </div>\n\n      <div className=\"w-full mb-8\">\n        <label className=\"block text-sm font-medium text-gray-700 mb-2\">Your Language</label>\n        <select \n          className=\"w-full p-4 bg-white border border-gray-200 rounded-2xl appearance-none focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm\"\n          value={selectedLanguage.code}\n          onChange={(e) => {\n            const lang = SUPPORTED_LANGUAGES.find(l => l.code === e.target.value);\n            if (lang) setSelectedLanguage(lang);\n          }}\n        >\n          {SUPPORTED_LANGUAGES.map(lang => (\n            <option key={lang.code} value={lang.code}>{lang.name}</option>\n          ))}\n        </select>\n      </div>\n\n      <div className=\"flex flex-col gap-4 w-full\">\n        <button\n          onClick={() => onStartCall(selectedLanguage)}\n          className=\"w-full py-4 px-6 bg-emerald-500 text-white rounded-2xl font-medium shadow-sm hover:bg-emerald-600 active:scale-[0.98] transition-all\"\n        >\n          Start a call\n        </button>\n        <button\n          onClick={() => onJoinCall(selectedLanguage)}\n          className=\"w-full py-4 px-6 bg-white text-gray-900 border border-gray-200 rounded-2xl font-medium shadow-sm hover:bg-gray-50 active:scale-[0.98] transition-all\"\n        >\n          Join a call\n        </button>\n      </div>\n    </motion.div>\n  );\n}\n"
    }
