  file_change {
    absolute_path_uri: "file:///src/components/JoinCall.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Language } from \'../types\';\nimport { useSocket } from \'../SocketContext\';\nimport { ArrowLeft } from \'lucide-react\';\n\ninterface JoinCallProps {\n  language: Language;\n  onBack: () => void;\n  onJoined: (roomCode: string) => void;\n  initialCode?: string;\n}\n\nexport function JoinCall({ language, onBack, onJoined, initialCode = \'\' }: JoinCallProps) {\n  const [code, setCode] = useState(initialCode);\n  const { socket } = useSocket();\n\n  useEffect(() => {\n    if (initialCode && initialCode.length === 6) {\n      handleJoin(initialCode);\n    }\n  }, [initialCode]);\n\n  const handleJoin = (joinCode: string = code) => {\n    if (joinCode.length === 6 && socket) {\n      socket.emit(\'join_room\', { roomCode: joinCode.toUpperCase(), language: language.name });\n      onJoined(joinCode.toUpperCase());\n    }\n  };\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, x: 20 }}\n      animate={{ opacity: 1, x: 0 }}\n      className=\"flex flex-col min-h-screen p-8 max-w-md mx-auto relative\"\n    >\n      <button \n        onClick={onBack}\n        className=\"absolute top-8 left-8 p-3 rounded-xl bg-transparent border border-gray-200 hover:bg-gray-100 transition-colors\"\n      >\n        <ArrowLeft className=\"w-5 h-5 text-gray-900\" />\n      </button>\n\n      <div className=\"text-center mt-24 mb-16\">\n        <h2 className=\"text-2xl font-semibold mb-3\">Enter Session Code</h2>\n        <p className=\"text-gray-500 text-sm\">Your language: {language.name}</p>\n      </div>\n\n      <div className=\"mb-10\">\n        <input\n          type=\"text\"\n          maxLength={6}\n          value={code}\n          onChange={(e) => setCode(e.target.value.toUpperCase())}\n          placeholder=\"6-LETTER CODE\"\n          className=\"w-full text-center text-3xl font-mono tracking-[0.3em] p-6 bg-transparent border-b-2 border-gray-200 focus:outline-none focus:border-emerald-500 transition-colors uppercase placeholder-gray-300 rounded-none\"\n        />\n      </div>\n\n      <button\n        onClick={() => handleJoin()}\n        disabled={code.length !== 6}\n        className=\"w-full py-4 px-6 bg-emerald-500 text-white rounded-xl font-medium transition-colors hover:bg-emerald-600 disabled:opacity-50 disabled:cursor-not-allowed mt-auto mb-8\"\n      >\n        Join call\n      </button>\n    </motion.div>\n  );\n}"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Language, SUPPORTED_LANGUAGES } from \'../types\';\nimport { useSocket } from \'../SocketContext\';\nimport { ArrowLeft, Camera, Keyboard } from \'lucide-react\';\nimport { Scanner } from \'@yudiel/react-qr-scanner\';\n\ninterface JoinCallProps {\n  language: Language;\n  onBack: () => void;\n  onJoined: (roomCode: string, lang: Language) => void;\n  initialCode?: string;\n}\n\ntype JoinMode = \'scan\' | \'manual\';\n\nexport function JoinCall({ language: initialLanguage, onBack, onJoined, initialCode = \'\' }: JoinCallProps) {\n  const [code, setCode] = useState(initialCode);\n  const [mode, setMode] = useState<JoinMode>(\'scan\');\n  const [language, setLanguage] = useState(initialLanguage);\n  const { socket } = useSocket();\n\n  useEffect(() => {\n    if (initialCode && initialCode.length === 6) {\n      setMode(\'manual\');\n    }\n  }, [initialCode]);\n\n  const handleJoin = (joinCode: string = code) => {\n    if (joinCode.length === 6 && socket) {\n      socket.emit(\'join_room\', { roomCode: joinCode.toUpperCase(), language: language.name });\n      onJoined(joinCode.toUpperCase(), language);\n    }\n  };\n\n  const handleScan = (detectedCodes: any[]) => {\n    if (detectedCodes && detectedCodes.length > 0) {\n      const result = detectedCodes[0].rawValue;\n      // Extract code from URL if it\'s a join URL\n      const urlMatch = result.match(/\\?join=([a-zA-Z0-9]{6})/i);\n      if (urlMatch && urlMatch[1]) {\n        handleJoin(urlMatch[1].toUpperCase());\n      } else if (result.length === 6) {\n        handleJoin(result.toUpperCase());\n      }\n    }\n  };\n\n  return (\n    <motion.div \n      initial={{ opacity: 0, x: 20 }}\n      animate={{ opacity: 1, x: 0 }}\n      className=\"flex flex-col min-h-screen p-8 max-w-md mx-auto relative\"\n    >\n      <button \n        onClick={onBack}\n        className=\"absolute top-8 left-8 p-3 rounded-xl bg-transparent border border-gray-200 hover:bg-gray-100 transition-colors z-10\"\n      >\n        <ArrowLeft className=\"w-5 h-5 text-gray-900\" />\n      </button>\n\n      <div className=\"text-center mt-24 mb-10\">\n        <h2 className=\"text-2xl font-semibold mb-3\">Join a Call</h2>\n        \n        <div className=\"mt-4 flex flex-col items-center\">\n          <label className=\"text-xs text-gray-500 mb-1 uppercase tracking-wider\">Your Language</label>\n          <select \n            className=\"p-2 bg-transparent text-gray-900 font-medium text-center focus:outline-none cursor-pointer\"\n            value={language.code}\n            onChange={(e) => {\n              const lang = SUPPORTED_LANGUAGES.find(l => l.code === e.target.value);\n              if (lang) setLanguage(lang);\n            }}\n          >\n            {SUPPORTED_LANGUAGES.map(lang => (\n              <option key={lang.code} value={lang.code}>{lang.name}</option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      <div className=\"flex-1 flex flex-col items-center justify-center w-full mb-10\">\n        <AnimatePresence mode=\"wait\">\n          {mode === \'scan\' ? (\n            <motion.div \n              key=\"scan\"\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              className=\"w-full max-w-[280px] aspect-square rounded-[2rem] overflow-hidden bg-gray-100 relative border border-gray-200\"\n            >\n              <Scanner \n                onScan={handleScan}\n                classNames={{\n                  container: \"w-full h-full object-cover\",\n                }}\n                components={{\n                  audio: false,\n                  finder: false,\n                }}\n              />\n              <div className=\"absolute inset-0 border-[40px] border-black/10 pointer-events-none rounded-[2rem]\" />\n              <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n                <div className=\"w-3/4 h-3/4 border-2 border-white/50 rounded-2xl\" />\n              </div>\n            </motion.div>\n          ) : (\n            <motion.div \n              key=\"manual\"\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.95 }}\n              className=\"w-full flex flex-col items-center\"\n            >\n              <input\n                type=\"text\"\n                maxLength={6}\n                value={code}\n                onChange={(e) => setCode(e.target.value.toUpperCase())}\n                placeholder=\"6-LETTER CODE\"\n                className=\"w-full max-w-[280px] text-center text-3xl font-mono tracking-[0.3em] p-6 bg-transparent border-b-2 border-gray-200 focus:outline-none focus:border-emerald-500 transition-colors uppercase placeholder-gray-300 rounded-none mb-8\"\n              />\n              \n              <button\n                onClick={() => handleJoin()}\n                disabled={code.length !== 6}\n                className=\"w-full max-w-[280px] py-4 px-6 bg-emerald-500 text-white rounded-xl font-medium transition-colors hover:bg-emerald-600 disabled:opacity-50 disabled:cursor-not-allowed\"\n              >\n                Join call\n              </button>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n\n      <div className=\"mt-auto mb-8 flex justify-center\">\n        <button\n          onClick={() => setMode(mode === \'scan\' ? \'manual\' : \'scan\')}\n          className=\"flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors\"\n        >\n          {mode === \'scan\' ? (\n            <>\n              <Keyboard className=\"w-4 h-4\" />\n              Enter code manually\n            </>\n          ) : (\n            <>\n              <Camera className=\"w-4 h-4\" />\n              Scan QR code\n            </>\n          )}\n        </button>\n      </div>\n    </motion.div>\n  );\n}"
    }
