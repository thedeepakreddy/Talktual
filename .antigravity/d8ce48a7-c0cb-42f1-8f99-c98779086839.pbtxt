    instruction: "Update useEffect for recognition.onresult"
    replacement_infos {
      original_chunk {
        target_content: "  // Update recognition to capture final results properly\n  useEffect(() => {\n    if (!recognitionRef.current) return;\n    const recognition = recognitionRef.current;\n    \n    recognition.onresult = (event: any) => {\n      let finalTranscript = \'\';\n      let currentInterim = \'\';\n      \n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) {\n          finalTranscript += event.results[i][0].transcript;\n        } else {\n          currentInterim += event.results[i][0].transcript;\n        }\n      }\n      \n      setInterimTranscript(currentInterim);\n      \n      if (finalTranscript.trim() && socket) {\n        setIsTranslating(true);\n        // We send it to the server to translate to the OTHER person\'s language.\n        // Wait, the server needs to know what language the other person wants. \n        // We only know our source lang. \n        // Actually, we can just let the server translate it to English if we don\'t know the target?\n        // Wait! The server should translate to the target person\'s language. But if the room has 2 people, \n        // how does the server know?\n        // The simplest way is for the server to NOT translate yet, OR we tell the server our target lang.\n        // But we don\'t know the other person\'s language!\n        // To fix this, we can ask the server to translate it when the OTHER person receives it, \n        // OR we broadcast the original text, and the recipient asks the server to translate.\n        // Let\'s broadcast the original text, and the recipient translates it. \n        // Wait, the backend already translates in \'speech_ended\'.\n        // Let\'s adjust backend: When user joins, they register their language.\n        // For simplicity, let\'s just have the recipient do the translation request!\n        // Ah, backend is currently: socket.on(\"speech_ended\", ... translates ...).\n        // If we send `sourceLang`, we can also just send `targetLang`. But we don\'t know their targetLang.\n        // Let\'s change the architecture:\n        // Sender emits: `translate_request`, { text, sourceLang }\n        // Wait, if the recipient is the one who needs it in their language, the recipient should tell the server.\n        // But sender wants to see their own text. \n        // Let\'s change the flow: Sender emits `send_speech` { originalText, sourceLang, speakerId } to Room.\n        // Everyone in the room (including sender) receives `receive_speech` { originalText, sourceLang, speakerId }.\n        // Wait, the user wants \"live transcript of both languages ... clearly distinguished\".\n        // If I am English, and they are Spanish:\n        // They say: \"Hola\" (Spanish).\n        // I see: \"Hola\" -> \"Hello\".\n        // I say: \"Hello\" (English).\n        // I see: \"Hello\" -> \"Hola\".\n        // So both people see both languages!\n        // Let\'s just have the sender request the translation. \n        // To do that, the sender needs to know the recipient\'s language. \n        // Let\'s just sync languages when joining!\n      }\n    };\n  }, [socket, myId]);"
        replacement_content: "  // Update recognition to capture final results properly\n  useEffect(() => {\n    if (!recognitionRef.current) return;\n    const recognition = recognitionRef.current;\n    \n    recognition.onresult = (event: any) => {\n      let finalTranscript = \'\';\n      let currentInterim = \'\';\n      \n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) {\n          finalTranscript += event.results[i][0].transcript;\n        } else {\n          currentInterim += event.results[i][0].transcript;\n        }\n      }\n      \n      setInterimTranscript(currentInterim);\n      \n      if (finalTranscript.trim() && socket) {\n        setIsTranslating(true);\n        socket.emit(\'speech_ended\', {\n          roomCode,\n          originalText: finalTranscript.trim(),\n          sourceLang: language.name,\n          speakerId: myId\n        });\n      }\n    };\n  }, [socket, myId, roomCode, language.name]);"
      }
      num_matches: 1
    }
  }
}
