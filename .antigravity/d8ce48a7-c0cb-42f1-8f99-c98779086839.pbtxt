    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect, useRef, useCallback } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Message, Language } from \'../types\';\nimport { useSocket } from \'../SocketContext\';\nimport { Mic, PhoneOff } from \'lucide-react\';\nimport { cn } from \'../utils\';\n\ninterface CallRoomProps {\n  roomCode: string;\n  language: Language;\n  onEndCall: () => void;\n}\n\nexport function CallRoom({ roomCode, language, onEndCall }: CallRoomProps) {\n  const { socket } = useSocket();\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [isListening, setIsListening] = useState(false);\n  const [isTranslating, setIsTranslating] = useState(false);\n  const [interimTranscript, setInterimTranscript] = useState(\'\');\n  const [myId] = useState(() => Math.random().toString(36).substring(7));\n  \n  const recognitionRef = useRef<any>(null);\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    // Scroll to bottom when messages change\n    if (scrollRef.current) {\n      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n    }\n  }, [messages, interimTranscript]);\n\n  useEffect(() => {\n    if (!socket) return;\n\n    socket.on(\'new_message\', (msg: Message) => {\n      setMessages(prev => [...prev, msg]);\n      \n      // If someone else spoke, we read their translated text out loud\n      if (msg.speakerId !== myId) {\n        speakText(msg.translatedText, msg.targetLang);\n      } else {\n        // We just got our own translation back\n        setIsTranslating(false);\n      }\n    });\n\n    return () => {\n      socket.off(\'new_message\');\n    };\n  }, [socket, myId]);\n\n  const speakText = (text: string, langCode: string) => {\n    if (\'speechSynthesis\' in window) {\n      const utterance = new SpeechSynthesisUtterance(text);\n      utterance.lang = langCode;\n      // We don\'t change state to \"speaking\" here because we don\'t have the explicit requirement for it, \n      // but it could be added. We\'ll just play it.\n      window.speechSynthesis.speak(utterance);\n    }\n  };\n\n  const startListening = useCallback(() => {\n    if (!(\'webkitSpeechRecognition\' in window) && !(\'SpeechRecognition\' in window)) {\n      alert(\'Speech recognition is not supported in this browser. Please use Chrome or Safari.\');\n      return;\n    }\n\n    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n    const recognition = new SpeechRecognition();\n    \n    recognition.lang = language.bcp47;\n    recognition.continuous = true; // Keep listening while holding\n    recognition.interimResults = true;\n\n    recognition.onstart = () => {\n      setIsListening(true);\n      setInterimTranscript(\'\');\n    };\n\n    recognition.onresult = (event: any) => {\n      let currentInterim = \'\';\n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (!event.results[i].isFinal) {\n          currentInterim += event.results[i][0].transcript;\n        }\n      }\n      setInterimTranscript(currentInterim);\n    };\n\n    recognition.onerror = (event: any) => {\n      console.error(\'Speech recognition error\', event.error);\n      stopListening(recognition);\n    };\n\n    recognition.start();\n    recognitionRef.current = recognition;\n  }, [language]);\n\n  const stopListening = useCallback((rec = recognitionRef.current) => {\n    if (rec) {\n      rec.stop();\n      setIsListening(false);\n      \n      // To get the final text, we actually listen for the onend event, \n      // but simpler to just let onresult handle the final part or send the text we have.\n      // Wait, webkitSpeechRecognition triggers onresult with isFinal. \n      // We need to capture the full string.\n    }\n  }, []);\n\n  // Update recognition to capture final results properly\n  useEffect(() => {\n    if (!recognitionRef.current) return;\n    const recognition = recognitionRef.current;\n    \n    recognition.onresult = (event: any) => {\n      let finalTranscript = \'\';\n      let currentInterim = \'\';\n      \n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) {\n          finalTranscript += event.results[i][0].transcript;\n        } else {\n          currentInterim += event.results[i][0].transcript;\n        }\n      }\n      \n      setInterimTranscript(currentInterim);\n      \n      if (finalTranscript.trim() && socket) {\n        setIsTranslating(true);\n        socket.emit(\'speech_ended\', {\n          roomCode,\n          originalText: finalTranscript.trim(),\n          sourceLang: language.name,\n          speakerId: myId\n        });\n      }\n    };\n  }, [socket, myId, roomCode, language.name]);\n\n  return (\n    <div className=\"flex flex-col min-h-screen bg-gray-50 relative max-w-md mx-auto\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between p-6 bg-white border-b border-gray-100 z-10\">\n        <div>\n          <h2 className=\"font-semibold text-gray-900\">Live Call</h2>\n          <p className=\"text-xs text-gray-500\">Session: {roomCode}</p>\n        </div>\n        <button \n          onClick={onEndCall}\n          className=\"p-3 bg-red-50 text-red-500 rounded-full hover:bg-red-100 transition-colors\"\n        >\n          <PhoneOff className=\"w-5 h-5\" />\n        </button>\n      </div>\n\n      {/* Transcript Feed */}\n      <div \n        ref={scrollRef}\n        className=\"flex-1 overflow-y-auto p-6 flex flex-col gap-6 pb-40\"\n      >\n        <AnimatePresence>\n          {messages.map((msg, idx) => {\n            const isMe = msg.speakerId === myId;\n            return (\n              <motion.div\n                key={idx}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className={cn(\"flex flex-col max-w-[85%]\", isMe ? \"self-end items-end\" : \"self-start items-start\")}\n              >\n                <div className={cn(\n                  \"p-4 rounded-xl\",\n                  isMe ? \"bg-emerald-500 text-white rounded-br-none\" : \"bg-white border border-gray-200 text-gray-900 rounded-bl-none\"\n                )}>\n                  <p className=\"text-lg mb-1\">{isMe ? msg.originalText : msg.translatedText}</p>\n                  <p className={cn(\"text-xs opacity-75\", isMe ? \"text-emerald-100\" : \"text-gray-500\")}>\n                    {isMe ? msg.translatedText : msg.originalText}\n                  </p>\n                </div>\n              </motion.div>\n            );\n          })}\n          \n          {interimTranscript && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              className=\"self-end max-w-[85%] bg-emerald-50 text-emerald-900 p-4 rounded-xl rounded-br-none\"\n            >\n              <p className=\"text-lg animate-pulse opacity-75\">{interimTranscript}</p>\n            </motion.div>\n          )}\n\n          {isTranslating && (\n             <motion.div\n               initial={{ opacity: 0 }}\n               animate={{ opacity: 1 }}\n               className=\"self-end max-w-[85%] mt-2\"\n             >\n               <div className=\"flex gap-2 p-3 bg-white border border-gray-200 rounded-xl\">\n                 <div className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" style={{ animationDelay: \'0ms\' }} />\n                 <div className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" style={{ animationDelay: \'150ms\' }} />\n                 <div className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" style={{ animationDelay: \'300ms\' }} />\n               </div>\n             </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n\n      {/* Controls */}\n      <div className=\"absolute bottom-0 left-0 right-0 p-8 bg-gray-50/90 backdrop-blur-sm flex justify-center pb-12 border-t border-gray-100\">\n        <button\n          onPointerDown={startListening}\n          onPointerUp={() => stopListening()}\n          onPointerLeave={() => stopListening()}\n          className={cn(\n            \"w-24 h-24 rounded-full flex items-center justify-center transition-all duration-300 select-none\",\n            isListening ? \"bg-emerald-500 scale-[1.02]\" : \"bg-white border-2 border-gray-200 text-emerald-500 hover:bg-gray-50\"\n          )}\n        >\n          <Mic className={cn(\"w-10 h-10 transition-colors\", isListening ? \"text-white\" : \"text-emerald-500\")} />\n        </button>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useState, useEffect, useRef, useCallback } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Message, Language } from \'../types\';\nimport { useSocket } from \'../SocketContext\';\nimport { Mic, PhoneOff, MessageSquare, X } from \'lucide-react\';\nimport { cn } from \'../utils\';\n\ninterface CallRoomProps {\n  roomCode: string;\n  language: Language;\n  onEndCall: () => void;\n}\n\nexport function CallRoom({ roomCode, language, onEndCall }: CallRoomProps) {\n  const { socket } = useSocket();\n  const [messages, setMessages] = useState<Message[]>([]);\n  const [isListening, setIsListening] = useState(false);\n  const [isTranslating, setIsTranslating] = useState(false);\n  const [isSpeaking, setIsSpeaking] = useState(false);\n  const [interimTranscript, setInterimTranscript] = useState(\'\');\n  const [showTranscript, setShowTranscript] = useState(false);\n  const [myId] = useState(() => Math.random().toString(36).substring(7));\n  \n  const recognitionRef = useRef<any>(null);\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (scrollRef.current) {\n      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n    }\n  }, [messages, interimTranscript, showTranscript]);\n\n  useEffect(() => {\n    if (!socket) return;\n\n    socket.on(\'new_message\', (msg: Message) => {\n      setMessages(prev => [...prev, msg]);\n      \n      if (msg.speakerId !== myId) {\n        speakText(msg.translatedText, msg.targetLang);\n      } else {\n        setIsTranslating(false);\n      }\n    });\n\n    return () => {\n      socket.off(\'new_message\');\n    };\n  }, [socket, myId]);\n\n  const speakText = (text: string, langCode: string) => {\n    if (\'speechSynthesis\' in window) {\n      const utterance = new SpeechSynthesisUtterance(text);\n      utterance.lang = langCode;\n      \n      utterance.onstart = () => setIsSpeaking(true);\n      utterance.onend = () => setIsSpeaking(false);\n      utterance.onerror = () => setIsSpeaking(false);\n      \n      window.speechSynthesis.speak(utterance);\n    }\n  };\n\n  const startListening = useCallback(() => {\n    if (!(\'webkitSpeechRecognition\' in window) && !(\'SpeechRecognition\' in window)) {\n      alert(\'Speech recognition is not supported in this browser. Please use Chrome or Safari.\');\n      return;\n    }\n\n    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n    const recognition = new SpeechRecognition();\n    \n    recognition.lang = language.bcp47;\n    recognition.continuous = true;\n    recognition.interimResults = true;\n\n    recognition.onstart = () => {\n      setIsListening(true);\n      setInterimTranscript(\'\');\n    };\n\n    recognition.onresult = (event: any) => {\n      let currentInterim = \'\';\n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (!event.results[i].isFinal) {\n          currentInterim += event.results[i][0].transcript;\n        }\n      }\n      setInterimTranscript(currentInterim);\n    };\n\n    recognition.onerror = (event: any) => {\n      console.error(\'Speech recognition error\', event.error);\n      stopListening(recognition);\n    };\n\n    recognition.start();\n    recognitionRef.current = recognition;\n  }, [language]);\n\n  const stopListening = useCallback((rec = recognitionRef.current) => {\n    if (rec) {\n      rec.stop();\n      setIsListening(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    if (!recognitionRef.current) return;\n    const recognition = recognitionRef.current;\n    \n    recognition.onresult = (event: any) => {\n      let finalTranscript = \'\';\n      let currentInterim = \'\';\n      \n      for (let i = event.resultIndex; i < event.results.length; ++i) {\n        if (event.results[i].isFinal) {\n          finalTranscript += event.results[i][0].transcript;\n        } else {\n          currentInterim += event.results[i][0].transcript;\n        }\n      }\n      \n      setInterimTranscript(currentInterim);\n      \n      if (finalTranscript.trim() && socket) {\n        setIsTranslating(true);\n        socket.emit(\'speech_ended\', {\n          roomCode,\n          originalText: finalTranscript.trim(),\n          sourceLang: language.name,\n          speakerId: myId\n        });\n      }\n    };\n  }, [socket, myId, roomCode, language.name]);\n\n  const getStateText = () => {\n    if (isListening) return \"Listening...\";\n    if (isTranslating) return \"Translating...\";\n    if (isSpeaking) return \"Speaking...\";\n    return \"Tap & Hold to Speak\";\n  };\n\n  return (\n    <div className=\"flex flex-col min-h-screen bg-gray-50 relative max-w-md mx-auto overflow-hidden\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between p-6 z-10\">\n        <div>\n          <h2 className=\"font-semibold text-gray-900\">Live Call</h2>\n          <p className=\"text-xs text-gray-500\">Session: {roomCode}</p>\n        </div>\n        <div className=\"flex gap-2\">\n          <button \n            onClick={() => setShowTranscript(true)}\n            className=\"p-3 bg-white text-gray-500 rounded-xl shadow-sm border border-gray-100 hover:bg-gray-50 transition-colors\"\n          >\n            <MessageSquare className=\"w-5 h-5\" />\n          </button>\n          <button \n            onClick={onEndCall}\n            className=\"p-3 bg-white text-red-500 rounded-xl shadow-sm border border-gray-100 hover:bg-red-50 transition-colors\"\n          >\n            <PhoneOff className=\"w-5 h-5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Main interaction area */}\n      <div className=\"flex-1 flex flex-col items-center justify-center p-8\">\n        \n        <div className=\"relative flex items-center justify-center w-64 h-64 mb-12\">\n          {/* Subtle animated background rings */}\n          <AnimatePresence>\n            {isListening && (\n              <motion.div \n                initial={{ opacity: 0, scale: 0.8 }}\n                animate={{ opacity: 1, scale: 1.2 }}\n                exit={{ opacity: 0, scale: 0.8 }}\n                className=\"absolute inset-0 bg-emerald-100 rounded-full blur-xl\"\n              />\n            )}\n            {isTranslating && (\n              <motion.div \n                initial={{ opacity: 0, scale: 0.8 }}\n                animate={{ opacity: 1, scale: 1.2 }}\n                exit={{ opacity: 0, scale: 0.8 }}\n                className=\"absolute inset-0 bg-blue-100 rounded-full blur-xl\"\n              />\n            )}\n            {isSpeaking && (\n              <motion.div \n                initial={{ opacity: 0, scale: 0.8 }}\n                animate={{ opacity: 1, scale: 1.2 }}\n                exit={{ opacity: 0, scale: 0.8 }}\n                className=\"absolute inset-0 bg-purple-100 rounded-full blur-xl\"\n              />\n            )}\n          </AnimatePresence>\n\n          <button\n            onPointerDown={startListening}\n            onPointerUp={() => stopListening()}\n            onPointerLeave={() => stopListening()}\n            className={cn(\n              \"relative w-32 h-32 rounded-[2.5rem] flex items-center justify-center transition-all duration-300 select-none z-10 shadow-sm border border-gray-200/50\",\n              isListening ? \"bg-emerald-500 scale-95 border-emerald-500\" : \n              isTranslating ? \"bg-blue-50 border-blue-200\" :\n              isSpeaking ? \"bg-purple-50 border-purple-200\" :\n              \"bg-white hover:bg-gray-50\"\n            )}\n          >\n            <Mic className={cn(\n              \"w-12 h-12 transition-colors\", \n              isListening ? \"text-white\" : \n              isTranslating ? \"text-blue-500\" :\n              isSpeaking ? \"text-purple-500 animate-pulse\" :\n              \"text-gray-900\"\n            )} />\n            \n            {/* Ripple when listening */}\n            {isListening && (\n              <span className=\"absolute inset-0 rounded-[2.5rem] border-4 border-emerald-500 animate-ping opacity-20\"></span>\n            )}\n          </button>\n        </div>\n\n        <motion.p \n          key={getStateText()}\n          initial={{ opacity: 0, y: 5 }}\n          animate={{ opacity: 1, y: 0 }}\n          className={cn(\n            \"text-sm font-medium tracking-wide\",\n            isListening ? \"text-emerald-600\" : \n            isTranslating ? \"text-blue-600\" :\n            isSpeaking ? \"text-purple-600\" :\n            \"text-gray-400\"\n          )}\n        >\n          {getStateText()}\n        </motion.p>\n      </div>\n\n      {/* Transcript Overlay */}\n      <AnimatePresence>\n        {showTranscript && (\n          <motion.div \n            initial={{ y: \"100%\" }}\n            animate={{ y: 0 }}\n            exit={{ y: \"100%\" }}\n            transition={{ type: \"spring\", damping: 25, stiffness: 200 }}\n            className=\"absolute inset-x-0 bottom-0 bg-white border-t border-gray-200 shadow-[0_-10px_40px_rgba(0,0,0,0.05)] rounded-t-3xl z-20 flex flex-col\"\n            style={{ height: \'75vh\' }}\n          >\n            <div className=\"flex items-center justify-between p-6 border-b border-gray-100\">\n              <h3 className=\"font-medium text-gray-900\">Live Transcript</h3>\n              <button \n                onClick={() => setShowTranscript(false)}\n                className=\"p-2 bg-gray-50 text-gray-500 rounded-full hover:bg-gray-100 transition-colors\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n            \n            <div \n              ref={scrollRef}\n              className=\"flex-1 overflow-y-auto p-6 flex flex-col gap-6\"\n            >\n              <AnimatePresence>\n                {messages.length === 0 && !interimTranscript && !isTranslating && (\n                  <div className=\"flex-1 flex items-center justify-center text-gray-400 text-sm\">\n                    No messages yet\n                  </div>\n                )}\n                \n                {messages.map((msg, idx) => {\n                  const isMe = msg.speakerId === myId;\n                  return (\n                    <motion.div\n                      key={idx}\n                      initial={{ opacity: 0, y: 10 }}\n                      animate={{ opacity: 1, y: 0 }}\n                      className={cn(\"flex flex-col max-w-[85%]\", isMe ? \"self-end items-end\" : \"self-start items-start\")}\n                    >\n                      <div className={cn(\n                        \"p-4 rounded-2xl\",\n                        isMe ? \"bg-emerald-500 text-white rounded-br-sm\" : \"bg-gray-50 border border-gray-100 text-gray-900 rounded-bl-sm\"\n                      )}>\n                        <p className=\"text-[15px] mb-1 leading-relaxed\">{isMe ? msg.originalText : msg.translatedText}</p>\n                        <p className={cn(\"text-[11px] uppercase tracking-wider opacity-75\", isMe ? \"text-emerald-100\" : \"text-gray-500\")}>\n                          {isMe ? msg.translatedText : msg.originalText}\n                        </p>\n                      </div>\n                    </motion.div>\n                  );\n                })}\n                \n                {interimTranscript && (\n                  <motion.div\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"self-end max-w-[85%] bg-emerald-50 text-emerald-900 p-4 rounded-2xl rounded-br-sm\"\n                  >\n                    <p className=\"text-[15px] animate-pulse opacity-75\">{interimTranscript}</p>\n                  </motion.div>\n                )}\n\n                {isTranslating && (\n                   <motion.div\n                     initial={{ opacity: 0 }}\n                     animate={{ opacity: 1 }}\n                     className=\"self-end max-w-[85%] mt-2\"\n                   >\n                     <div className=\"flex gap-2 p-3 bg-white border border-gray-100 rounded-2xl\">\n                       <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" style={{ animationDelay: \'0ms\' }} />\n                       <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" style={{ animationDelay: \'150ms\' }} />\n                       <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\" style={{ animationDelay: \'300ms\' }} />\n                     </div>\n                   </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
    }
