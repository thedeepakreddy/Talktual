# ---------------------------------------------------------------------------
# FRONTEND (Vite) — these are bundled into the client, so never put keys here.
# ---------------------------------------------------------------------------

# WebSocket URL of the signaling server. Its http(s) form is also where the
# API proxy lives, so this one value configures everything.
#   local:      ws://localhost:8080
#   deployed:   wss://your-signaling-server.example.com
VITE_SIGNALING_URL="ws://localhost:8080"


# Optional TURN server. STUN alone can't punch through symmetric NAT, which is
# common on mobile carriers and corporate wifi. Without TURN those calls still
# work — they just relay text through the signaling server instead of going
# peer to peer, which is unnoticeable since only text crosses the wire.
# VITE_TURN_URL="turn:turn.example.com:3478"
# VITE_TURN_USERNAME="user"
# VITE_TURN_CREDENTIAL="pass"


# ---------------------------------------------------------------------------
# BACKEND (signaling-server/.env) — secrets live here only.
# ---------------------------------------------------------------------------

# ElevenLabs powers text-to-speech, and speech-to-text on browsers that lack
# the Web Speech API. Without it the app falls back to the browser's built-in
# voice, which still works but sounds robotic.
# (The server also accepts VITE_ELEVENLABS_API_KEY for backward compatibility
# but warns: VITE_* names are for browser-bundled values and must never hold
# secrets.)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Optional. eleven_flash_v2_5 is the default: ~75ms to first audio byte.
# Swap to eleven_multilingual_v2 for better quality at roughly +1s of latency.
# ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"
# ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# TTS_SAMPLE_RATE="24000"

# Translation provider. The server picks the first one configured and falls
# back to MyMemory (no key, but slower and capped at 5k chars/day per IP).
# A real provider is also what enables live translated captions while the
# other person is still speaking.
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.5-flash-lite"
# DEEPL_API_KEY="your-deepl-api-key"

# Optional: raises the keyless MyMemory limit to 50k chars/day. Not a signup.
# MYMEMORY_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# BACKEND hardening (Phase 1). Strongly recommended in production.
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to use the API proxy and signaling.
# Unset = any website can spend your provider quota through this server.
# ALLOWED_ORIGINS="https://your-frontend.example.com"

# Per-IP budget for /api/* (translate, tts, stt) per minute. 0/unset = off.
# A live-caption listener makes ~2-3 translate calls/second while the other
# person talks, so leave generous headroom (e.g. 600).
# RATE_LIMIT_PER_MINUTE="600"

# Set to 1 behind a single reverse proxy (Render, Heroku, Fly) so the rate
# limiter sees real client IPs instead of the proxy's.
# TRUST_PROXY="1"

# Limits (defaults shown).
# MAX_TEXT_CHARS="2000"            # per translate/tts request
# MAX_UPLOAD_BYTES="10485760"      # per STT upload
# MAX_WS_PAYLOAD_BYTES="65536"     # per signaling frame
# TRANSLATE_TIMEOUT_MS="8000"
# TTS_TIMEOUT_MS="10000"           # time to first byte
# STT_TIMEOUT_MS="30000"
# SESSION_TIMEOUT_MS="600000"      # unpaired lobby lifetime
